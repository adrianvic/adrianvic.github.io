<html lang="{{ langKey or "en" }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/phone.css">
    <title>tenkuma</title>
    <link href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css" rel="stylesheet"/>
    <meta property="og:title" content="tenkuma{% if pageTitle or postTitle %} - {{ pageTitle or postTitle }}{% endif %}">
    <meta property="og:description" content="{{ description or i18n[langKey].websiteDescription }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ page.url | url | absoluteUrl }}">
    <meta property="og:image" content="{% if pageTitle or postTitle %}{{ 'static/images/posts/' + background | url | absoluteUrl }}{% else %}{{ 'static/images/bear.jpg' | url | absoluteUrl }}{% endif %}">
</head>
<body>
    {{ content | safe }}
</body>